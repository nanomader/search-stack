{
  "name": "search-stack",
  "version": "0.1.1",
  "description": "Compare live search engines side by side in a simple desktop app.",
  "homepage": "https://github.com/nanomader/search-stack",
  "repository": {
    "type": "git",
    "url": "https://github.com/nanomader/search-stack.git"
  },
  "main": "src/main.js",
  "author": "Search Stack contributors",
  "private": true,
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm test && npm run test:e2e",
    "start": "electron .",
    "package:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --publish never",
    "package:win": "electron-builder --win nsis --publish never",
    "package:linux": "electron-builder --linux AppImage deb --publish never",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:live": "node tests/live-smoke.js",
    "package:mac:signed": "electron-builder --config build/macos-release.cjs --mac dmg zip --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "prettier": "3.9.9"
  },
  "build": {
    "appId": "dev.searchstack.app",
    "productName": "Search Stack",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "Search-Stack-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
